# Ignore everything inside the theme folder by default
/*
# But don't ignore the .gitignore file itself
!/.gitignore

# Whitelist the core theme files and folders you need to track
!/style.css
!/functions.php
!/screenshot.png
!/theme.json
!/index.php

# Whitelist the template parts and block folders
!/assets/
!/blocks/
!/parts/
!/patterns/
!/templates/

# Development files to exclude
.DS_Store
*.log
node_modules/
*.sql
*.sqlite

# Build artifacts (if you use a build process)
*.asset.php   # Generated by @wordpress/scripts
/build/       # Compiled block files